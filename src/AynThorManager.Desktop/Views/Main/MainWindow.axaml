<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AynThorManager.Desktop"
        x:Class="AynThorManager.Desktop.MainWindow"
        Title="Ayn Thor Manager" Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid ColumnDefinitions="350,*">

        <Border Grid.Column="0" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Ayn Thor Manager" FontSize="16" FontWeight="Bold" Foreground="#00d4ff" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#ff5252" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Desconectado" FontSize="11" Foreground="#78909c" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="12" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Conexao" FontSize="11" Foreground="#78909c" Margin="0,0,0,6" />

                        <!-- O Thor cria o hotspot 5GHz; o PC conecta nele -->
                        <TextBlock Text="Rede do Thor (SSID)" FontSize="10" Foreground="#78909c" Margin="0,0,0,2" />
                        <TextBox x:Name="TxtThorSsid" Classes="input" Watermark="AynThor"
                                 HorizontalAlignment="Stretch" />
                        <TextBlock Text="Senha" FontSize="10" Foreground="#78909c" Margin="0,6,0,2" />
                        <TextBox x:Name="TxtThorPassword" Classes="input" PasswordChar="•"
                                 HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                        <Button x:Name="BtnDirectConnect" Content="📡 Conectar ao Thor"
                                Click="BtnDirectConnect_Click"
                                Classes="btn primary" HorizontalAlignment="Stretch" />
                        <Button x:Name="BtnDirectRetry" Content="🔄 Tentar de novo"
                                Click="BtnDirectRetry_Click" IsVisible="False"
                                Classes="btn primary" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        <Button x:Name="BtnPrepareUsb" Content="🔌 Preparar via USB (1ª vez)"
                                Click="BtnPrepareUsb_Click"
                                Classes="btn default" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                ToolTip.Tip="Conecte o Thor por cabo USB com a Depuração USB ativa. Faça isso uma vez para habilitar a conexão sem fio pela porta fixa; depois pode tirar o cabo." />
                        <Button x:Name="BtnDirectStop" Content="Encerrar Conexão"
                                Click="BtnDirectStop_Click" IsVisible="False"
                                Classes="btn danger" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="DirectMessage" FontSize="11" Foreground="#78909c"
                                   Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="False" />

                        <TextBlock x:Name="ConnMessage" FontSize="11" Foreground="#78909c" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="NetStatsPanel" Padding="8,6"
                            BorderBrush="#0f3460" BorderThickness="0,0,0,1" IsVisible="False">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Ping: " />
                                <TextBlock x:Name="TxtPing" FontSize="10" Foreground="#00d4ff" Text="--" />
                                <TextBlock FontSize="10" Foreground="#78909c" Text=" ms" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Banda: " />
                                <TextBlock x:Name="TxtBand" FontSize="10" Foreground="#00d4ff" Text="--" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Wi-Fi: " />
                                <TextBlock x:Name="TxtFreq" FontSize="10" Foreground="#00d4ff" Text="--" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Sinal: " />
                                <TextBlock x:Name="TxtSignal" FontSize="10" Foreground="#00d4ff" Text="--" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Button Grid.Column="0" Content="⬆" Click="BtnUp_Click" Classes="btn icon"
                                        ToolTip.Tip="Pasta acima" />
                                <Border Grid.Column="1" Background="#0e1a30" CornerRadius="3" Margin="8,0" Padding="8,0"
                                        VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PathDisplay" Text="/storage/" VerticalAlignment="Center"
                                               FontFamily="monospace" FontSize="11" Foreground="#00d4ff"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="2" Content="⟳" Click="BtnRefresh_Click" Classes="btn icon"
                                        Margin="0,0,4,0" ToolTip.Tip="Atualizar" />
                                <Button Grid.Column="3" Content="＋" Classes="btn primary icon" ToolTip.Tip="Adicionar">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="📁 Nova pasta" Click="BtnNewFolder_Click" />
                                            <MenuItem Header="📄 Novo documento" Click="BtnNewFile_Click" />
                                            <MenuItem Header="⬆️ Enviar arquivo..." Click="BtnUpload_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top"
                               Text="Pasta vazia&#x0a;Arraste arquivos aqui para enviar"
                               Foreground="#546e7a" FontSize="12" FontStyle="Italic" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,24,0,0" IsVisible="False" />

                    <ListBox x:Name="FileList" Classes="files" Background="Transparent" BorderThickness="0"
                             Foreground="#e0e0e0" FontSize="12"
                             DragDrop.AllowDrop="True"
                             DoubleTapped="FileList_DoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:FileItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Width="26"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#e0e0e0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Modified}" Foreground="#546e7a" FontSize="9"
                                                   IsVisible="{Binding Modified, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Margin="8,0,4,0"
                                               Foreground="#78909c" FontSize="10" VerticalAlignment="Center" />

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="✏️ Renomear" Click="BtnRename_Click" />
                                            <MenuItem Header="🗑️ Excluir" Click="BtnDelete_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="12" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <!-- Direção do streaming (Req 1.1). Dois ToggleButtons mutuamente
                         exclusivos: Thor→PC é o padrão (scrcpy, comportamento atual);
                         PC→Thor é o fluxo reverso (Sunshine + Moonlight). -->
                    <Border Background="#0e1a30" CornerRadius="4" Padding="2" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ToggleThorToPc" Content="Thor → PC"
                                          IsChecked="True"
                                          Click="ToggleThorToPc_Click"
                                          Classes="btn default" FontSize="11" Padding="10,4" />
                            <ToggleButton x:Name="TogglePcToThor" Content="PC → Thor"
                                          Click="TogglePcToThor_Click"
                                          Classes="btn default" FontSize="11" Padding="10,4" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Botão de ação único: despacha para o sentido selecionado (Req 1.2). -->
                    <Button x:Name="BtnStream" Content="Espelhar Tela" Click="BtnStream_Click" Classes="btn primary" Margin="0,0,8,0" />
                    <Button x:Name="BtnStopStream" Content="Parar" Click="BtnStopStream_Click" Classes="btn danger" IsVisible="False" />
                    <TextBlock x:Name="StreamStatus" Text="Inativo" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" Foreground="#78909c" TextWrapping="Wrap" />

                    <!-- Link para a WebUI do Sunshine, visível quando o PC→Thor está ativo:
                         leva o usuário direto ao painel (parear, PIN, configurar). -->
                    <Button x:Name="BtnSunshineWebUi" Content="Acessar Sunshine: https://localhost:47990"
                            Click="BtnSunshineWebUi_Click" Classes="btn default" FontSize="11"
                            Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center"
                            IsVisible="False"
                            ToolTip.Tip="Abre o painel do Sunshine no navegador" />
                </StackPanel>
            </Border>

            <!-- Aviso best-effort, não-bloqueante (Req 5.2 / 6.2). Aparece quando o encode
                 por hardware (VAAPI) não é confirmado — provável fallback para software,
                 que degrada a performance em jogos — ou quando a captura via Portal não
                 está disponível. É apenas um aviso: o streaming segue permitido. Fica
                 separado da checklist bloqueante dos pré-requisitos (6.3). -->
            <Border x:Name="WarningBanner" DockPanel.Dock="Top" IsVisible="False"
                    Background="#2e2a16" BorderBrush="#f0a202" BorderThickness="0,0,0,2"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠" Foreground="#f0a202" FontSize="15" VerticalAlignment="Top" />
                    <TextBlock x:Name="WarningText" Foreground="#ffd27a" FontSize="11"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Background="Black">
                <Grid>
                    <!-- Dica padrão (Thor→PC): o scrcpy abre a tela do Thor em janela
                         separada. Visível por padrão; escondido quando o fluxo guiado
                         de pré-requisitos do PC→Thor assume o centro. -->
                    <StackPanel x:Name="ScrcpyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="Clique em &quot;Espelhar Tela&quot; para abrir a tela do Thor"
                                   Foreground="#78909c" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="A tela abre em uma janela separada do scrcpy."
                                   Foreground="#546e7a" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Fluxo guiado de pré-requisitos (Req 2.3/2.4/6.2). Só o que falta é
                         listado, cada item com nome, orientação e um link clicável quando
                         houver URL. O app apenas orienta — nunca instala nada. -->
                    <Border x:Name="PrereqPanel" IsVisible="False" Padding="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="520">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Pré-requisitos para usar o PC no Thor"
                                       Foreground="#00d4ff" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Resolva os itens abaixo e tente de novo. O app não instala nada por você — só orienta."
                                       Foreground="#78909c" FontSize="11" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center" />

                            <ItemsControl x:Name="PrereqList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PrereqItem">
                                        <Border Background="#16213e" BorderBrush="#0f3460" BorderThickness="1"
                                                CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="⚠" Foreground="#ff5252" FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Foreground="#e0e0e0"
                                                               FontSize="13" FontWeight="Bold"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Guidance}" Foreground="#78909c"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           IsVisible="{Binding Guidance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <Button Content="Abrir link"
                                                        Click="PrereqLink_Click"
                                                        Tag="{Binding Url}"
                                                        Classes="btn primary" FontSize="11" Padding="10,4"
                                                        HorizontalAlignment="Left" Margin="0,2,0,0"
                                                        IsVisible="{Binding HasUrl}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
