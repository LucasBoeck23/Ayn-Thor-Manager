<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AynThorManager.Desktop.InputDialog"
        Title="Input" Width="360" Height="170"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#16213e">
    <Border BorderBrush="#0f3460" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock x:Name="Prompt" Foreground="#e0e0e0" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" Classes="input" FontSize="13" Padding="8,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="8">
                <Button Content="Cancelar" Click="Cancel_Click" Classes="btn default" />
                <Button Content="OK" Click="Ok_Click" Classes="btn primary" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
