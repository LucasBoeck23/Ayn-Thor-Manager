<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AynThorManager.Desktop"
        x:Class="AynThorManager.Desktop.MainWindow"
        Title="Ayn Thor Manager" Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid ColumnDefinitions="350,*">

        <!-- Painel esquerdo: Conexao + Navegador de arquivos -->
        <Border Grid.Column="0" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="12" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Ayn Thor Manager" FontSize="16" FontWeight="Bold" Foreground="#00d4ff" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#ff5252" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Desconectado" FontSize="11" Foreground="#78909c" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Conexao -->
                <Border DockPanel.Dock="Top" Padding="12" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Conexao" FontSize="11" Foreground="#78909c" Margin="0,0,0,6" />

                        <!-- Conexao direta: PC vira hotspot, Thor conecta nele (rede dedicada) -->
                        <Button x:Name="BtnDirectConnect" Content="📡 Conectar (Hotspot)"
                                Click="BtnDirectConnect_Click"
                                Classes="btn primary" HorizontalAlignment="Stretch" />
                        <Button x:Name="BtnDirectRetry" Content="🔄 Tentar de novo (reescanear portas)"
                                Click="BtnDirectRetry_Click" IsVisible="False"
                                Classes="btn primary" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        <Button x:Name="BtnDirectStop" Content="Encerrar Conexão Direta"
                                Click="BtnDirectStop_Click" IsVisible="False"
                                Classes="btn danger" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="DirectMessage" FontSize="11" Foreground="#78909c"
                                   Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="False" />

                        <TextBlock x:Name="ConnMessage" FontSize="11" Foreground="#78909c" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Navegador de arquivos -->
                <DockPanel>
                    <!-- Stats de rede -->
                    <Border DockPanel.Dock="Top" x:Name="NetStatsPanel" Padding="8,6"
                            BorderBrush="#0f3460" BorderThickness="0,0,0,1" IsVisible="False">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Ping: " />
                                <TextBlock x:Name="TxtPing" FontSize="10" Foreground="#00d4ff" Text="--" />
                                <TextBlock FontSize="10" Foreground="#78909c" Text=" ms" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Banda: " />
                                <TextBlock x:Name="TxtBand" FontSize="10" Foreground="#00d4ff" Text="--" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Wi-Fi: " />
                                <TextBlock x:Name="TxtFreq" FontSize="10" Foreground="#00d4ff" Text="--" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="10" Foreground="#78909c" Text="Sinal: " />
                                <TextBlock x:Name="TxtSignal" FontSize="10" Foreground="#00d4ff" Text="--" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Barra de caminho + acoes -->
                    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Button Grid.Column="0" Content="⬆" Click="BtnUp_Click" Classes="btn icon"
                                        ToolTip.Tip="Pasta acima" />
                                <Border Grid.Column="1" Background="#0e1a30" CornerRadius="3" Margin="8,0" Padding="8,0"
                                        VerticalAlignment="Stretch">
                                    <TextBlock x:Name="PathDisplay" Text="/storage/" VerticalAlignment="Center"
                                               FontFamily="monospace" FontSize="11" Foreground="#00d4ff"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="2" Content="⟳" Click="BtnRefresh_Click" Classes="btn icon"
                                        Margin="0,0,4,0" ToolTip.Tip="Atualizar" />
                                <Button Grid.Column="3" Content="＋" Classes="btn primary icon" ToolTip.Tip="Adicionar">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="📁 Nova pasta" Click="BtnNewFolder_Click" />
                                            <MenuItem Header="📄 Novo documento" Click="BtnNewFile_Click" />
                                            <MenuItem Header="⬆️ Enviar arquivo..." Click="BtnUpload_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dica de pasta vazia -->
                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top"
                               Text="Pasta vazia&#x0a;Arraste arquivos aqui para enviar"
                               Foreground="#546e7a" FontSize="12" FontStyle="Italic" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,24,0,0" IsVisible="False" />

                    <!-- Lista de arquivos (aceita arrastar-e-soltar para upload) -->
                    <ListBox x:Name="FileList" Classes="files" Background="Transparent" BorderThickness="0"
                             Foreground="#e0e0e0" FontSize="12"
                             DragDrop.AllowDrop="True"
                             DoubleTapped="FileList_DoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:FileItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Width="26"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#e0e0e0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Modified}" Foreground="#546e7a" FontSize="9"
                                                   IsVisible="{Binding Modified, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Margin="8,0,4,0"
                                               Foreground="#78909c" FontSize="10" VerticalAlignment="Center" />

                                    <!-- Menu de contexto: renomear / excluir -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="✏️ Renomear" Click="BtnRename_Click" />
                                            <MenuItem Header="🗑️ Excluir" Click="BtnDelete_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Painel direito: scrcpy embutido -->
        <DockPanel Grid.Column="1">
            <!-- Toolbar do stream -->
            <Border DockPanel.Dock="Top" Padding="12" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnStream" Content="Espelhar Tela" Click="BtnStream_Click" Classes="btn primary" Margin="0,0,8,0" />
                    <Button x:Name="BtnStopStream" Content="Parar" Click="BtnStopStream_Click" Classes="btn danger" IsVisible="False" />
                    <TextBlock x:Name="StreamStatus" Text="Inativo" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" Foreground="#78909c" />
                </StackPanel>
            </Border>

            <!-- O espelhamento abre em uma janela própria do scrcpy. -->
            <Border Background="Black">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="Clique em &quot;Espelhar Tela&quot; para abrir a tela do Thor"
                               Foreground="#78909c" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="A tela abre em uma janela separada do scrcpy."
                               Foreground="#546e7a" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
