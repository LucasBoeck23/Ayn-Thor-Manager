<Window x:Class="AynThorManager.Desktop.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="320" Height="150" WindowStartupLocation="CenterOwner"
        Background="#16213e" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Foreground="#e0e0e0" FontSize="13" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Padding="6" FontSize="13" Background="#0e1a30" Foreground="#e0e0e0" BorderBrush="#0f3460"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Padding="10,5" Margin="0,0,8,0" Click="Cancel_Click" Background="#0f3460" Foreground="#e0e0e0" BorderThickness="0"/>
            <Button Content="OK" Padding="10,5" Click="Ok_Click" Background="#00d4ff" Foreground="Black" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
