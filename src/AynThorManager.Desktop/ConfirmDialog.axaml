<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AynThorManager.Desktop.ConfirmDialog"
        Title="Confirmar" Width="380" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#16213e">
    <Border BorderBrush="#0f3460" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleText" Foreground="#ff5252" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText" Foreground="#e0e0e0" FontSize="13" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="8">
                <Button Content="Cancelar" Click="Cancel_Click" Classes="btn default" />
                <Button Content="Excluir" Click="Confirm_Click" Classes="btn danger" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
