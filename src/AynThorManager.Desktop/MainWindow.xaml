<Window x:Class="AynThorManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayn Thor Manager" Width="1100" Height="750"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Connection + File Browser -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Text="Ayn Thor Manager" Style="{StaticResource TextTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Danger}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="Desconectado" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connection -->
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Text="Conexao" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IpInput" Grid.Column="0" Style="{StaticResource InputText}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button x:Name="BtnScan" Content="Buscar" Click="BtnScan_Click" Style="{StaticResource BtnDefault}" Margin="0,0,4,0"/>
                                <Button x:Name="BtnConnect" Content="Conectar" Click="BtnConnect_Click" Style="{StaticResource BtnPrimary}"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="BtnInstallCompanion" Content="📲 Instalar Ayn Thor Link"
                                Click="BtnInstallCompanion_Click" Visibility="Collapsed"
                                Style="{StaticResource BtnPrimary}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="ConnMessage" Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- File Browser -->
                <DockPanel Margin="0">
                    <!-- Network stats -->
                    <Border DockPanel.Dock="Top" x:Name="NetStatsPanel" Padding="8,6" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="10" Foreground="{StaticResource TextSecondary}">
                                <Run Text="Ping: "/><Run x:Name="TxtPing" Text="--" Foreground="{StaticResource Accent}"/><Run Text=" ms"/>
                            </TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="10" Foreground="{StaticResource TextSecondary}">
                                <Run Text="Banda: "/><Run x:Name="TxtBand" Text="--" Foreground="{StaticResource Accent}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0">
                                <Run Text="Wi-Fi: "/><Run x:Name="TxtFreq" Text="--" Foreground="{StaticResource Accent}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0">
                                <Run Text="Sinal: "/><Run x:Name="TxtSignal" Text="--" Foreground="{StaticResource Accent}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Path bar -->
                    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="^" Click="BtnUp_Click" Width="28" Style="{StaticResource BtnDefault}" Padding="4"/>
                            <TextBlock x:Name="PathDisplay" Grid.Column="1" Text="/storage/" VerticalAlignment="Center"
                                       Margin="8,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Accent}"/>
                            <Button Grid.Column="2" Content="+" Click="BtnNewFolder_Click" Width="28" Style="{StaticResource BtnDefault}" Padding="4" ToolTip="Nova pasta"/>
                        </Grid>
                    </Border>

                    <!-- File list -->
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}" FontSize="12"
                             MouseDoubleClick="FileList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <TextBlock Text="{Binding Icon}" Width="20"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Size}" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Right Panel: Scrcpy Embedded -->
        <DockPanel Grid.Column="1">
            <!-- Stream toolbar -->
            <Border DockPanel.Dock="Top" Padding="12" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnStream" Content="Espelhar Tela" Click="BtnStream_Click" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnStopStream" Content="Parar" Click="BtnStopStream_Click" Style="{StaticResource BtnDanger}" Visibility="Collapsed"/>
                    <TextBlock x:Name="StreamStatus" Text="Inativo" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource TextCaption}"/>
                </StackPanel>
            </Border>

            <!-- Scrcpy host area -->
            <Border x:Name="ScrcpyPanel" Background="Black"/>
        </DockPanel>
    </Grid>
</Window>
